{
  "name": "ide-test-feedback-vscode",
  "displayName": "IDE Test Feedback for Moodle",
  "description": "Run your unit tests and submit the results to Moodle",
  "version": "0.1.0",
  "publisher": "mroosioks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maanusroosioks/vscode-plugin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:.ide-test-feedback.json",
    "workspaceContains:pom.xml",
    "workspaceContains:build.gradle",
    "workspaceContains:build.gradle.kts",
    "workspaceContains:settings.gradle",
    "workspaceContains:settings.gradle.kts",
    "workspaceContains:pytest.ini",
    "workspaceContains:pyproject.toml",
    "workspaceContains:setup.cfg",
    "workspaceContains:conftest.py",
    "workspaceContains:test_*.py",
    "workspaceContains:*_test.py",
    "workspaceContains:tests/test_*.py",
    "workspaceContains:tests/*_test.py",
    "workspaceContains:test/test_*.py",
    "workspaceContains:test/*_test.py",
    "workspaceContains:*.csproj",
    "workspaceContains:*.sln",
    "workspaceContains:*.slnx",
    "workspaceContains:*/*.csproj"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Running tests executes the project's own build and test code, so the extension only runs in trusted workspaces."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ideTestFeedback.runAndSubmit",
        "title": "Run Tests & Submit to Moodle",
        "category": "IDE Test Feedback",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "ideTestFeedback.runTestsOnly",
        "title": "Run Tests (No Submit)",
        "category": "IDE Test Feedback"
      },
      {
        "command": "ideTestFeedback.login",
        "title": "Sign In with Microsoft",
        "category": "IDE Test Feedback"
      },
      {
        "command": "ideTestFeedback.logout",
        "title": "Sign Out",
        "category": "IDE Test Feedback"
      },
      {
        "command": "ideTestFeedback.configureAssignment",
        "title": "Configure Assignment",
        "category": "IDE Test Feedback"
      },
      {
        "command": "ideTestFeedback.showOutput",
        "title": "Show Log",
        "category": "IDE Test Feedback"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ideTestFeedback.runAndSubmit",
          "when": "view == workbench.view.testing",
          "group": "navigation@100"
        }
      ],
      "testing/item/context": [
        {
          "command": "ideTestFeedback.runAndSubmit",
          "when": "controllerId == ideTestFeedback.tests",
          "group": "ideTestFeedback@1"
        }
      ]
    },
    "configuration": [
      {
        "id": "connection",
        "title": "Connection",
        "order": 1,
        "properties": {
          "ideTestFeedback.serviceUrl": {
            "type": "string",
            "default": "",
            "description": "Base URL of the submission service (e.g. https://ide-feedback-gateway.example.edu). Can only be set in user settings, so a project cannot redirect where your sign-in token is sent.",
            "scope": "machine"
          },
          "ideTestFeedback.authScopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "User.Read"
            ],
            "description": "OAuth scopes to request from the Microsoft authentication provider. Only change this if your course's submission service tells you to. Can only be set in user settings.",
            "scope": "machine"
          },
          "ideTestFeedback.requestTimeoutMs": {
            "type": "number",
            "default": 15000,
            "description": "Timeout in milliseconds for requests to the submission service.",
            "minimum": 1000,
            "maximum": 120000
          }
        }
      },
      {
        "id": "running",
        "title": "Running Tests",
        "order": 2,
        "properties": {
          "ideTestFeedback.preferredAdapter": {
            "type": "string",
            "enum": [
              "maven-junit",
              "gradle-junit",
              "pytest",
              "dotnet-test"
            ],
            "description": "Force a specific test adapter instead of relying on auto-detection.",
            "scope": "resource"
          },
          "ideTestFeedback.testCommandOverrides": {
            "type": "object",
            "default": {},
            "description": "Per-adapter command overrides, e.g. { \"maven-junit\": \"mvn -Pci test\" }, for projects with nonstandard build setups. Give a single command with no shell operators (&&, |, ;): the reporting flags that let the extension read the results are appended to whatever you put here.",
            "scope": "resource"
          }
        }
      },
      {
        "id": "sourceCapture",
        "title": "Source Capture",
        "order": 3,
        "properties": {
          "ideTestFeedback.submitTestSource": {
            "type": "boolean",
            "default": true,
            "description": "Submit the source of each test that ran, so your instructor sees the code behind each result. Turning this off still submits the results and where each test was found.",
            "scope": "resource"
          },
          "ideTestFeedback.maxTotalSourceChars": {
            "type": "number",
            "default": 500000,
            "description": "Largest amount of source captured across one submission. Once it's used up, the remaining files are submitted without their content.",
            "scope": "resource",
            "minimum": 1,
            "maximum": 1000000
          },
          "ideTestFeedback.warnOnSuspiciousTests": {
            "type": "boolean",
            "default": true,
            "description": "Warn before submitting when tests look emptied or disabled. The warning never blocks a submission.",
            "scope": "resource"
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "setup",
        "title": "Set up IDE Test Feedback",
        "description": "Connect to your course's submission service and submit your first run.",
        "when": "!ideTestFeedback.configured",
        "steps": [
          {
            "id": "configure",
            "title": "Configure the submission service",
            "description": "Tell the extension where your course's submission service lives.\n[Configure Assignment](command:ideTestFeedback.configureAssignment)",
            "media": {
              "markdown": "media/walkthrough/configure.md"
            },
            "completionEvents": [
              "onContext:ideTestFeedback.configured"
            ]
          },
          {
            "id": "signin",
            "title": "Sign in with Microsoft",
            "description": "Authenticate so submissions are tied to your account.\n[Sign In with Microsoft](command:ideTestFeedback.login)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onCommand:ideTestFeedback.login"
            ]
          },
          {
            "id": "firstRun",
            "title": "Run tests & submit",
            "description": "Open a project with tests and submit your first run.\n[Run Tests & Submit](command:ideTestFeedback.runAndSubmit)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:ideTestFeedback.runAndSubmit"
            ]
          }
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".ide-test-feedback.json",
        "url": "./schemas/ide-test-feedback.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "npm run package"
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/vsce": "^2.31.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
